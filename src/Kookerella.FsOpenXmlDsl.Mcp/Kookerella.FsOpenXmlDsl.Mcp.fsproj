<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>

  <PropertyGroup>
    <!-- Publishes as a `dotnet tool` (`dotnet tool install -g Kookerella.FsOpenXmlDsl.Mcp`)
         rather than a plain console app - the natural distribution shape for a local MCP
         server, since an MCP client just needs a command it can launch as a subprocess,
         not a network address (see the project's own README for why this runs locally
         rather than as a hosted service). -->
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>fsopenxmldsl-mcp</ToolCommandName>
    <Version>0.1.2</Version>
    <Authors>Kookerella</Authors>
    <Company>Kookerella Ltd</Company>
    <Description>MCP (Model Context Protocol) server exposing Kookerella.FsOpenXmlDsl's Excel read/write/code-generation capabilities as tools any MCP-compatible AI agent can call directly - build a workbook, read one back, or regenerate its F# source - without the agent needing to write any F# itself.</Description>
    <PackageTags>mcp;model-context-protocol;ai;agent;excel;xlsx;openxml;fsharp;dotnet-tool</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageProjectUrl>https://github.com/Kookerella-Ltd/Kookerella.FsOpenXmlDsl</PackageProjectUrl>
    <RepositoryUrl>https://github.com/Kookerella-Ltd/Kookerella.FsOpenXmlDsl</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\LICENSE" Pack="true" PackagePath="/" />
    <None Include="README.md" Pack="true" PackagePath="/" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="WorkbookTools.fs" />
    <Compile Include="Program.fs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ModelContextProtocol" Version="2.2.0" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.11" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Kookerella.FsOpenXmlDsl\Kookerella.FsOpenXmlDsl.fsproj" />
  </ItemGroup>

</Project>
