<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
  </PropertyGroup>

  <PropertyGroup>
    <!-- Publishes as a `dotnet tool` (`dotnet tool install -g Kookerella.FsOpenXmlDsl.Mcp`)
         rather than a plain console app - the natural distribution shape for a local MCP
         server, since an MCP client just needs a command it can launch as a subprocess,
         not a network address (see the project's own README for why this runs locally
         rather than as a hosted service). -->
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>fsopenxmldsl-mcp</ToolCommandName>
    <Version>0.6.1</Version>
    <Authors>Kookerella</Authors>
    <Company>Kookerella Ltd</Company>
    <Description>MCP (Model Context Protocol) server exposing Kookerella.FsOpenXmlDsl's Excel capabilities as tools any MCP-compatible AI agent can call directly: build a workbook, read one back, decompile an existing one into idiomatic F# or C# source, or translate to/from plain XML or JSON, each against a real schema. The XML/JSON directions each have two uses beyond code generation: build an .xlsx directly from XML/JSON a transform engine (e.g. XSLT) or generation script already produces, no code required; or convert an existing .xlsx to XML/JSON for text-based diffing and version control in systems like git, with deterministically ordered output so real content changes stay isolated in the diff. The same conversions are available as plain CLI commands (fsopenxmldsl-mcp convert/build) for anyone not going through an MCP client.</Description>
    <PackageTags>mcp;model-context-protocol;ai;agent;excel;xlsx;openxml;fsharp;dotnet-tool</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageProjectUrl>https://github.com/Kookerella-Ltd/Kookerella.FsOpenXmlDsl</PackageProjectUrl>
    <RepositoryUrl>https://github.com/Kookerella-Ltd/Kookerella.FsOpenXmlDsl</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\LICENSE" Pack="true" PackagePath="/" />
    <None Include="README.md" Pack="true" PackagePath="/" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="WorkbookTools.fs" />
    <Compile Include="Program.fs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ModelContextProtocol" Version="2.2.0" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.11" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Kookerella.FsOpenXmlDsl\Kookerella.FsOpenXmlDsl.fsproj" />
    <!-- Needed only for generate_csharp_script - it loads the workbook through the C#
         wrapper's own WorkbookIO.Load (rather than the F# core's Workbook.load) so it can
         feed a Workbook the wrapper's own CsCodeGen.Generate understands, without needing
         WorkbookConverter (internal to that assembly) exposed publicly. -->
    <ProjectReference Include="..\Kookerella.CsOpenXmlDsl\Kookerella.CsOpenXmlDsl.csproj" />
  </ItemGroup>

</Project>
