<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <PropertyGroup>
    <!-- NuGet package identity and listing metadata. PackageId/AssemblyName default to
         the project filename (Kookerella.FsOpenXmlDsl), so they're intentionally not
         overridden here. Version is a plain field to bump by hand per release - there's
         no CI/release pipeline driving it yet. -->
    <Version>0.2.0</Version>
    <Authors>Kookerella</Authors>
    <Company>Kookerella Ltd</Company>
    <Description>A typesafe F# DSL for building and reading Excel workbooks (.xlsx/.xlsm), interpreted into calls against the DocumentFormat.OpenXml SDK. Unlike write-only Excel generators, this round-trips and can decompile an existing file into equivalent, runnable F# source (Workbook.generateScript) or plain XML against a real embedded schema (Xml.ofWorkbook/Xml.toWorkbook, Xml.xsd) - read a real spreadsheet, get back the code or data that rebuilds it. The XML direction doubles as a way to build an .xlsx from XML a transform engine (e.g. XSLT) already produces, and to convert an existing .xlsx to XML for text-based diffing/version control, with deterministically ordered output so real content changes stay isolated in the diff. Covers cells, styles, formulas (including shared-formula reconstruction on read), conditional formatting, data validation, tables, charts, images, pivot tables (with real aggregation), sparklines, and VBA macro embedding.</Description>
    <PackageTags>fsharp;excel;xlsx;xlsm;openxml;spreadsheet;spreadsheetml;dsl;code-generation;round-trip;pivot-table;vba</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <PackageProjectUrl>https://github.com/Kookerella-Ltd/Kookerella.FsOpenXmlDsl</PackageProjectUrl>
    <RepositoryUrl>https://github.com/Kookerella-Ltd/Kookerella.FsOpenXmlDsl</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>

  <ItemGroup>
    <!-- Packs the repo-root README/LICENSE into the .nupkg so they render on the NuGet
         gallery page and satisfy PackageReadmeFile above - PackagePath="/" puts them at
         the package root rather than nested under this project's own folder. -->
    <None Include="..\..\README.md" Pack="true" PackagePath="/" />
    <None Include="..\..\LICENSE" Pack="true" PackagePath="/" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="Reference.fs" />
    <Compile Include="Styles.fs" />
    <Compile Include="Validation.fs" />
    <Compile Include="Hyperlinks.fs" />
    <Compile Include="Comments.fs" />
    <Compile Include="Protection.fs" />
    <Compile Include="DefinedNames.fs" />
    <Compile Include="PageSetup.fs" />
    <Compile Include="Tables.fs" />
    <Compile Include="Sparklines.fs" />
    <Compile Include="Charts.fs" />
    <Compile Include="Images.fs" />
    <Compile Include="PivotTables.fs" />
    <Compile Include="Model.fs" />
    <Compile Include="Xml.fs" />
    <Compile Include="Json.fs" />
    <Compile Include="Builders.fs" />
    <Compile Include="Interpreter\StyleRegistry.fs" />
    <Compile Include="Interpreter\ChartWriter.fs" />
    <Compile Include="Interpreter\ChartReader.fs" />
    <Compile Include="Interpreter\ImageWriter.fs" />
    <Compile Include="Interpreter\ImageReader.fs" />
    <Compile Include="Interpreter\DrawingWriter.fs" />
    <Compile Include="Interpreter\DrawingReader.fs" />
    <Compile Include="Interpreter\PivotTableWriter.fs" />
    <Compile Include="Interpreter\PivotTableReader.fs" />
    <Compile Include="Interpreter\Writer.fs" />
    <Compile Include="Interpreter\Reader.fs" />
    <Compile Include="Interpreter\CodeGen.fs" />
    <Compile Include="Api.fs" />
  </ItemGroup>

  <ItemGroup>
    <!-- Embedded (not just a loose repo file) so `Xml.schemaSet()` works for a consumer of
         the published package too, who has no repo checkout to read a physical path from. -->
    <EmbeddedResource Include="Xml.xsd">
      <LogicalName>Kookerella.FsOpenXmlDsl.Xml.xsd</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="DocumentFormat.OpenXml" Version="3.5.1" />
  </ItemGroup>

</Project>
