<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- CS1591 (missing XML doc on a public member) is suppressed deliberately: this
         codebase only documents members whose WHY isn't obvious from the name, not every
         trivial property/method - see the main project's own commenting philosophy. -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <PropertyGroup>
    <Version>0.4.1</Version>
    <Authors>Kookerella</Authors>
    <Company>Kookerella Ltd</Company>
    <Description>An idiomatic, immutable, fluent C# wrapper over Kookerella.FsOpenXmlDsl - build and read Excel workbooks (.xlsx/.xlsm) from C# without touching F# discriminated unions or option types directly. Unlike libraries that only build or mutate a workbook through an imperative API, this can also decompile an existing .xlsx/.xlsm into idiomatic, runnable C# or F# source that rebuilds it (CsCodeGen.Generate/FsCodeGen.Generate), or convert it to/from schema-validated XML or JSON (WorkbookXml/WorkbookJson) - read a real spreadsheet, get back the code or data that rebuilds it. Covers every feature the F# core models: cell values/formulas, styling (incl. per-cell lock/hide protection), merged ranges/freeze panes/autofilter, Excel Tables, charts, images, pivot tables, sparklines, conditional formatting, data validation, hyperlinks, comments, print settings, defined names, sheet/workbook protection, and VBA (as opaque bytes).</Description>
    <PackageTags>csharp;excel;xlsx;xlsm;openxml;spreadsheet;dsl;fluent;immutable</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageProjectUrl>https://github.com/Kookerella-Ltd/Kookerella.FsOpenXmlDsl</PackageProjectUrl>
    <RepositoryUrl>https://github.com/Kookerella-Ltd/Kookerella.FsOpenXmlDsl</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\LICENSE" Pack="true" PackagePath="/" />
    <None Include="README.md" Pack="true" PackagePath="/" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Kookerella.FsOpenXmlDsl\Kookerella.FsOpenXmlDsl.fsproj" />
  </ItemGroup>

</Project>
