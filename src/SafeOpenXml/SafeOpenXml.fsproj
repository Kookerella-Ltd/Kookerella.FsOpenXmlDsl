    <Compile Include="Protection.fs" />
    <Compile Include="DefinedNames.fs" />
    <Compile Include="PageSetup.fs" />
    <Compile Include="Model.fs" />
    <Compile Include="Builders.fs" />
    <Compile Include="Interpreter\StyleRegistry.fs" />
    <Compile Include="Interpreter\Writer.fs" />
    <Compile Include="Interpreter\Reader.fs" />
    <Compile Include="Interpreter\CodeGen.fs" />
