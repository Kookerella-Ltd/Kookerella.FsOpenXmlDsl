<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <!-- DocumentFormat.OpenXml is a direct dependency here purely for this test suite's
         own schema-validation helper (OpenXmlValidator) - a real consumer of the wrapper
         wouldn't need it, the same way the F# test project's own use of it is test-only. -->
    <PackageReference Include="DocumentFormat.OpenXml" Version="3.5.1" />
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <!-- Linked rather than copied: this is the same real vbaProject.bin the F# test suite
         uses (extracted from a workbook actually saved by Excel), and one genuine fixture
         shared by both suites beats two copies drifting apart. -->
    <None Include="..\Kookerella.FsOpenXmlDsl.Tests\Assets\sample.vbaProject.bin"
          Link="Assets\sample.vbaProject.bin"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!-- Examples/*/script.cs is generated documentation output (see ExampleTests.cs), not
         part of this test assembly - it's a standalone file-based app (with its own
         #:project directive and top-level statements) meant to be run via `dotnet run
         script.cs`, not compiled into this project. The default SDK glob would otherwise
         try to compile it here too, which fails outright (#: directives aren't valid
         syntax outside a file-based app, and a second file with top-level statements
         collides with this project's own). -->
    <Compile Remove="Examples\**\*.cs" />
    <None Include="Examples\**\*.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Kookerella.CsOpenXmlDsl\Kookerella.CsOpenXmlDsl.csproj" />
  </ItemGroup>

</Project>
