<workbook>
  <sheets>
    <sheet name="Sheet1">
      <cells>
        <cell ref="A1">
          <text>Name</text>
          <style>
            <font bold="true">
              <color>
                <rgb r="255" g="255" b="255" />
              </color>
            </font>
            <fill>
              <rgb r="68" g="84" b="106" />
            </fill>
            <border>
              <bottom style="thin">
                <color>
                  <rgb r="0" g="0" b="0" />
                </color>
              </bottom>
            </border>
          </style>
        </cell>
        <cell ref="B1">
          <text>Amount</text>
          <style>
            <font bold="true">
              <color>
                <rgb r="255" g="255" b="255" />
              </color>
            </font>
            <fill>
              <rgb r="68" g="84" b="106" />
            </fill>
            <border>
              <bottom style="thin">
                <color>
                  <rgb r="0" g="0" b="0" />
                </color>
              </bottom>
            </border>
          </style>
        </cell>
        <cell ref="A2">
          <text>Row 1</text>
        </cell>
        <cell ref="B2">
          <number>1</number>
        </cell>
        <cell ref="A3">
          <text>Row 2</text>
        </cell>
        <cell ref="B3">
          <number>2</number>
        </cell>
      </cells>
      <freezePane rows="1" columns="0" />
    </sheet>
  </sheets>
</workbook>