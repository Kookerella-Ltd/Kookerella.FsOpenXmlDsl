<workbook>
  <sheets>
    <sheet name="Sheet1">
      <cells>
        <cell ref="A1">
          <number>0.5</number>
          <style>
            <numberFormat custom="0.000%" />
          </style>
        </cell>
        <cell ref="A2">
          <number>5</number>
        </cell>
      </cells>
      <conditionalFormats>
        <conditionalFormat topLeft="A2" bottomRight="A2">
          <cellValueRule operator="greaterThan" formula1="0">
            <style>
              <fill>
                <rgb r="255" g="199" b="206" />
              </fill>
            </style>
          </cellValueRule>
        </conditionalFormat>
      </conditionalFormats>
    </sheet>
  </sheets>
</workbook>