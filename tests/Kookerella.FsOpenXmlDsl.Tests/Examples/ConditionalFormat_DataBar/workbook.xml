<workbook>
  <sheets>
    <sheet name="Sheet1">
      <cells>
        <cell ref="A1">
          <number>10</number>
        </cell>
        <cell ref="A2">
          <number>50</number>
        </cell>
        <cell ref="A3">
          <number>90</number>
        </cell>
      </cells>
      <conditionalFormats>
        <conditionalFormat topLeft="A1" bottomRight="A3">
          <dataBarRule>
            <color>
              <rgb r="0" g="0" b="255" />
            </color>
          </dataBarRule>
        </conditionalFormat>
      </conditionalFormats>
    </sheet>
  </sheets>
</workbook>