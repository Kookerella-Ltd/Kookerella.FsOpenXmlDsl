<workbook>
  <sheets>
    <sheet name="Sheet1">
      <cells>
        <cell ref="A1">
          <number>50</number>
        </cell>
        <cell ref="A2">
          <number>150</number>
        </cell>
        <cell ref="A3">
          <number>90</number>
        </cell>
      </cells>
      <conditionalFormats>
        <conditionalFormat topLeft="A1" bottomRight="A3">
          <cellValueRule operator="greaterThan" formula1="100">
            <style>
              <fill>
                <rgb r="255" g="199" b="206" />
              </fill>
            </style>
          </cellValueRule>
        </conditionalFormat>
      </conditionalFormats>
    </sheet>
  </sheets>
</workbook>