<workbook>
  <sheets>
    <sheet name="Sheet1">
      <cells>
        <cell ref="A1">
          <number>10</number>
        </cell>
        <cell ref="A2">
          <number>50</number>
        </cell>
        <cell ref="A3">
          <number>90</number>
        </cell>
      </cells>
      <conditionalFormats>
        <conditionalFormat topLeft="A1" bottomRight="A3">
          <colorScale3>
            <minColor>
              <rgb r="255" g="0" b="0" />
            </minColor>
            <midColor>
              <rgb r="255" g="255" b="0" />
            </midColor>
            <maxColor>
              <rgb r="0" g="128" b="0" />
            </maxColor>
          </colorScale3>
        </conditionalFormat>
      </conditionalFormats>
    </sheet>
  </sheets>
</workbook>