<workbook>
  <sheets>
    <sheet name="Sheet1">
      <cells>
        <cell ref="A1">
          <number>5</number>
        </cell>
      </cells>
      <conditionalFormats>
        <conditionalFormat topLeft="A1" bottomRight="A1">
          <cellValueRule operator="greaterThan" formula1="0">
            <style>
              <font bold="true" />
              <fill>
                <rgb r="255" g="0" b="0" />
              </fill>
              <border>
                <bottom style="thin">
                  <color>
                    <rgb r="0" g="0" b="0" />
                  </color>
                </bottom>
              </border>
              <alignment horizontal="center" />
            </style>
          </cellValueRule>
        </conditionalFormat>
      </conditionalFormats>
    </sheet>
  </sheets>
</workbook>