<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="XmlTests.fs" />
    <Compile Include="JsonTests.fs" />
    <Compile Include="Tests.fs" />
  </ItemGroup>

  <ItemGroup>
    <!-- Not compiled - these are the per-scenario example workbooks (and their
         regenerating scripts and equivalent XML - see verifyScenarioNamed in Tests.fs)
         each test in Tests.fs generates. Listed explicitly so Solution Explorer shows
         them; F#'s SDK doesn't auto-include files the way C#'s does. *.xlsm covers
         VbaMacro's own output (the one scenario needing the macro-enabled extension) -
         this was missing before Xml.fs existed too, not something *.xml introduced. -->
    <None Include="Examples\**\*.xlsx" />
    <None Include="Examples\**\*.xlsm" />
    <None Include="Examples\**\*.fsx" />
    <None Include="Examples\**\*.xml" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="JsonSchema.Net" Version="9.4.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Kookerella.FsOpenXmlDsl\Kookerella.FsOpenXmlDsl.fsproj" />
  </ItemGroup>

</Project>